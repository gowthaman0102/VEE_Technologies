APP_NAME=AI Media Intelligence
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
CORS_ORIGINS=https://your-frontend-service.up.railway.app

DATABASE_URL=postgresql+asyncpg://media_user:change_me@localhost:5432/media_intelligence

NEWSAPI_API_KEY=your_newsapi_api_key_here
NEWSAPI_BASE_URL=https://newsapi.org/v2

# Embeddings
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
SEMANTIC_RELEVANCE_THRESHOLD=0.45

# Local LLM / Ollama
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=120

# Queue / Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_DEFAULT_QUEUE=media-intelligence
CELERY_TASK_TIME_LIMIT_SECONDS=300
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=270

# Alert delivery
ALERT_DELIVERY_PROVIDER=slack
ALERT_DELIVERY_TIMEOUT_SECONDS=10
ALERT_DELIVERY_MAX_RETRIES=3
SLACK_WEBHOOK_URL=
